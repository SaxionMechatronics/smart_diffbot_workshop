<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Camera model -->
  <xacro:include filename="$(find smart_diffbot_description)/model/urdf/camera.urdf.xacro" />

  <!-- Properties -->
  <xacro:property name="base_length" value="0.1415"/>
  <xacro:property name="base_width" value="0.09"/>
  <xacro:property name="base_height" value="0.07"/>
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.018"/>
  <xacro:property name="wheel_suspension" value="0.01"/>
  <xacro:property name="wheel_spacing" value="0.002"/>
  <xacro:property name="caster_radius" value="0.015"/>

  <!-- Links -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
      <material name="SaxionGreen">
        <color rgba="0 0.612 0.510 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
    </collision>
    <xacro:box_inertia m="30.0" w="${base_width}" d="${base_length}" h="${base_height}"/>
  </link>

  <link name="base_footprint"/>

  <link name="camera_mount"/>
  <xacro:camera name="camera" parent="camera_mount"/>

  <!-- Other sensor links (not visualized) -->
  <link name="imu_link"/>
  <link name="navsat_link"/>
  

  <!-- Wheel links -->
  <xacro:wheel name="left_wheel" width="${wheel_width}" radius="${wheel_radius}" mass="1.0" color="white"/>
  <xacro:wheel name="right_wheel" width="${wheel_width}" radius="${wheel_radius}" mass="1.0" color="white"/>

  <link name="caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="0.25" r="${caster_radius}"/>
  </link>

  <!-- Joints -->
  <joint name="footprint_joint" type="fixed">
      <origin xyz="0 0 ${- base_height/2.0 - wheel_radius + wheel_suspension}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="base_footprint"/>
  </joint>

  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="${base_length/2.0-camera_radius*2.0} 0 ${base_height/2.0}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_mount"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <joint name="navsat_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="navsat_link"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${-base_length/4.0} ${base_width/2.0 + wheel_width/2.0 + wheel_spacing} ${-base_height/2.0 + wheel_suspension}" rpy="0 0 0"/>
    <axis xyz="0 1 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${-base_length/4.0} -${base_width/2.0 + wheel_width/2.0 + wheel_spacing} ${-base_height/2.0 + wheel_suspension}" rpy="0 0 0"/>
    <axis xyz="0 1 0" rpy="0 0 0"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${base_length/3.0} 0 ${-base_height/2.0 + wheel_suspension - wheel_radius + caster_radius}" rpy="0 0 0"/>
  </joint>

</robot>
<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="camera_link_width" value="0.002"/>
  <xacro:property name="camera_link_depth" value="0.005"/>
  <xacro:property name="camera_length" value="0.025"/>
  <xacro:property name="camera_height" value="0.01"/>
  <xacro:property name="camera_base_height" value="0.005"/>
  <xacro:property name="camera_offset" value="0.005"/>
  <xacro:property name="camera_radius" value="0.01"/>
  <xacro:property name="camera_link_length" value="0.03"/>
  <xacro:property name="lens_radius" value="0.004"/>
  <xacro:property name="lens_length" value="0.002"/>

  <!-- Wheel macro -->
  <xacro:macro name="camera" params="name parent">

    <!-- Camera body -->
    <link name="${name}_body_link">
      <visual>
        <origin xyz="${camera_length/4} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${camera_radius}" length="${camera_length}"/>
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${camera_radius}" length="${camera_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="1.0" r="${camera_radius}" h="${camera_length}"/>
    </link>

    <!-- Camera lens -->
    <link name="${name}_lens_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${lens_radius}" length="${lens_length}" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lens_radius}" length="${lens_length}" />
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.1" r="${lens_radius}" h="${lens_length}"/>
    </link>

    <!-- Camera sensor link -->
    <link name="${name}_sensor_link"/>

      <!-- Camera base -->
    <link name="${name}_base">
      <visual>
        <origin xyz="0 0 ${camera_base_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${camera_radius}" length="${camera_height}" />
        </geometry>
        <material name="SaxionGreen" />
      </visual>
      <collision>
        <origin xyz="0 0 ${camera_base_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${camera_radius}" length="${camera_height}" />
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="1.0" r="${camera_radius}" h="${camera_height}"/>
    </link>

    <!-- Camera link -->
      <link name="${name}_link">
      <visual>
        <origin xyz="0 ${camera_radius+camera_link_width/2.0} ${camera_link_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_link_depth} ${camera_link_width} ${camera_link_length}" />
        </geometry>
        <material name="white"/>
      </visual>
      <visual>
        <origin xyz="0 -${camera_radius+camera_link_width/2.0} ${camera_link_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_link_depth} ${camera_link_width} ${camera_link_length}" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 ${camera_radius*2.0+camera_link_width/2.0} ${camera_link_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_link_depth} ${camera_link_width} ${camera_link_length}" />
        </geometry>
      </collision>
      <xacro:box_inertia m="1.0" w="${camera_link_depth}" d="${camera_link_width}" h="${camera_link_length}"/>
    </link>

    <!-- Camera joints -->
    <joint name="${name}_sensor_joint" type="fixed">
      <origin xyz="${lens_length/2.0 + 0.1} 0 0" rpy="0 0 0"/>
      <parent link="${name}_lens_link"/>
      <child link="${name}_sensor_link"/>
    </joint>

    <joint name="${name}_lens_joint" type="fixed">
      <origin xyz="${3.0*camera_length/4.0} 0 0" rpy="0 0 0"/>
      <parent link="${name}_body_link"/>
      <child link="${name}_lens_link"/>
    </joint>

    <joint name="${name}_link_joint" type="revolute">
      <parent link="${name}_base"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 ${camera_height-camera_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0" rpy="0 0 0"/>
      <limit effort="30" velocity="1.0" lower="${-pi/2}" upper="${pi/2}" />
    </joint>

    <joint name="${name}_top_joint" type="revolute">
      <parent link="${name}_link"/>
      <child link="${name}_body_link"/>
      <origin xyz="0 0 ${camera_link_length-camera_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0" rpy="0 0 0"/>
      <limit effort="30" velocity="1.0" lower="-31.415" upper="31.415" />
    </joint>

    <joint name="${name}_base_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}_base"/>
      <axis xyz="0 0 1" rpy="0 0 0"/>
      <limit effort="30" velocity="1.0" lower="-31.415" upper="31.415" />
    </joint>
  </xacro:macro>
</robot>